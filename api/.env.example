PORT=4000
CORS_ORIGIN=http://localhost:8080

# Postgres connection string (Supabase local stack, or a real project's connection string in prod)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Supabase project — server-side only, never expose these to the frontend
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret-key-from-`supabase-status`

# Stripe — generate sandbox keys with `npx stripe sandbox create --email you@example.com`
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:4000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# CinetPay — from your CinetPay merchant account (test mode)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_TRANSFER_LOGIN=
CINETPAY_TRANSFER_PASSWORD=

# OpenRouter — powers the MCP agents report-analysis pipeline (services/mcpAgents).
# Get a key at https://openrouter.ai/keys. Without it, the pipeline still runs (fire
# and forget on every report submission) but every agent fails fast and cleanly —
# analysisStatus still reaches "terminee", just with no real analysis attached.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_SITE_URL=http://localhost:8080

# One OpenRouter model slug per provider — each of the 7 MCP agents uses one of these
# four (see mcpAgents/agents/*.ts). Change here to swap models, no code change needed.
OPENROUTER_MODEL_DEEPSEEK=deepseek/deepseek-chat
OPENROUTER_MODEL_QWEN=qwen/qwen-2.5-72b-instruct
OPENROUTER_MODEL_KIMI=moonshotai/kimi-k2
OPENROUTER_MODEL_CHATGPT=openai/gpt-4o-mini
