generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Profiles
// Supabase Auth owns `auth.users` (email, password hash, sessions, MFA).
// `Profile.id` mirrors that user's id and carries the app-specific fields
// (role, name, avatar) that Supabase Auth itself doesn't store.
//
// Roles/permissions are data, not an enum: a new role (with any combination of
// existing permissions) can be created from the admin UI with zero deploy. The
// permission *keys* themselves are still defined in code (something has to know
// what "reports.triage" gates), but which roles have which permissions is fully
// dynamic. See api/src/services/roles/permissionCatalog.ts for the fixed catalog
// and api/src/services/roles/rolesService.ts for role CRUD.
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  label       String
  description String?
  // Protects the 6 roles the app ships with from deletion/rename-away via the API —
  // custom roles created later are not system roles and can be freely removed.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  profiles    Profile[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  label       String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Profile {
  id        String   @id @db.Uuid
  email     String   @unique
  name      String
  roleId    String   @db.Uuid
  role      Role     @relation(fields: [roleId], references: [id])
  avatar    String?
  createdAt DateTime @default(now())

  hackerProfile     HackerProfile?
  entrepriseProfile EntrepriseProfile?
  logs              PlatformLog[]
  reviewedFraudSignals FraudSignal[] @relation("FraudSignalReviewedBy")

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Hackers
// ---------------------------------------------------------------------------

enum HackerStatus {
  actif
  banni
  suspendu
}

enum PaymentMethod {
  mobile_money
  bank_transfer
  bank_card
  paypal
  crypto
}

enum MobileMoneyProvider {
  airtel
  mtn
  moov
  orange
}

enum CryptoType {
  btc
  eth
  usdt
}

enum PreferredCurrency {
  USD
  EUR
  XAF
}

enum CardBrand {
  visa
  mastercard
  amex
  other
}

model HackerProfile {
  id           String       @id @default(uuid()) @db.Uuid
  profileId    String       @unique @db.Uuid
  profile      Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reputation   Int          @default(0)
  bugsFound    Int          @default(0)
  totalRewards Int          @default(0)
  // No stored rank column: leaderboard position is always computed from reputation
  // at read time (hackersService.ts computeRanks) so it can never drift out of sync
  // or be hand-edited into an inconsistent value.
  specialties  String[]     @default([])
  status       HackerStatus @default(actif)
  joinedAt     DateTime     @default(now())

  // Stripe Connect v2 Recipient account id, set once the hacker completes onboarding.
  stripeAccountId String?

  badges        Badge[]
  paymentConfig HackerPaymentConfig?
  reports       Report[]
  payouts       Payout[]

  @@map("hacker_profiles")
}

model Badge {
  id          String        @id @default(uuid()) @db.Uuid
  hackerId    String        @db.Uuid
  hacker      HackerProfile @relation(fields: [hackerId], references: [id], onDelete: Cascade)
  name        String
  icon        String
  description String

  @@map("badges")
}

// Note: `cardCvv` is deliberately NOT persisted anywhere in this schema —
// CVV must never be stored, even at rest. Full PCI-compliant tokenisation
// via a payment provider is tracked separately (roadmap item #13).
model HackerPaymentConfig {
  id           String        @id @default(uuid()) @db.Uuid
  hackerId     String        @unique @db.Uuid
  hacker       HackerProfile @relation(fields: [hackerId], references: [id], onDelete: Cascade)

  gainsEnabled       Boolean               @default(false)
  paymentMethods     PaymentMethod[]       @default([])

  mobileMoneyProvider MobileMoneyProvider?
  phoneNumber          String?

  accountName        String?
  bankName           String?
  accountHolderName  String?
  accountNumber      String?
  iban               String?
  swiftCode          String?
  bankCountry        String?

  cardBrand           CardBrand?
  cardHolderName      String?
  cardNumberLast4     String?
  cardExpiry          String?
  cardBillingCountry  String?

  paypalEmail         String?

  cryptoType          CryptoType?
  walletAddress       String?

  preferredCurrency        PreferredCurrency @default(USD)
  autoWithdrawal            Boolean          @default(false)
  minimumPayoutThreshold    String           @default("50")

  // Drives the payment_anomaly heuristic (fraudService.ts): a config edited right
  // before a payout request is a signal, not provable fraud on its own.
  updatedAt DateTime @updatedAt

  @@map("hacker_payment_configs")
}

// ---------------------------------------------------------------------------
// Entreprises
// ---------------------------------------------------------------------------

enum EntrepriseStatus {
  actif
  suspendu
}

model EntrepriseProfile {
  id              String           @id @default(uuid()) @db.Uuid
  profileId       String           @unique @db.Uuid
  profile         Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sector          String
  programmesCount Int              @default(0)
  totalPaid       Int              @default(0)
  status          EntrepriseStatus @default(actif)
  joinedAt        DateTime         @default(now())

  programmes Programme[]
  reports    Report[]
  payments   Payment[]

  @@map("entreprise_profiles")
}

// ---------------------------------------------------------------------------
// Programmes
// ---------------------------------------------------------------------------

enum ProgrammeStatus {
  actif
  pause
  ferme
}

enum ProgrammeType {
  public
  private
  vdp
}

enum SafeHarbor {
  partiel
  complet
  aucun
}

enum TestingPeriod {
  ongoing
  scheduled
  closed
}

enum RewardCurrency {
  USD
  EUR
  XAF
}

enum Severity {
  critique
  haute
  moyenne
  faible
  info
}

model Programme {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  entrepriseId    String            @db.Uuid
  entreprise      EntrepriseProfile @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  description     String
  descriptionLong String?
  overview        String?
  scope           String[]          @default([])
  outOfScope      String[]          @default([])
  methodology     String?
  eligibility     String[]          @default([])
  howItWorks      String[]          @default([])
  responsibleDisclosure String[]    @default([])
  rulesOfEngagement String[]        @default([])
  hardwareResearchRegistration String?
  focusAreas      String[]          @default([])
  nonQualifyingFindings String[]    @default([])
  terms           String[]          @default([])
  disclosurePolicy String?
  communicationChannels String[]    @default([])
  tags            String[]          @default([])
  sector          String?
  logoUrl         String?
  website         String?

  safeHarbor      SafeHarbor?
  scopeRating     Int?
  testingPeriod   TestingPeriod?
  startedAt       DateTime?
  statusText      String?
  lastUpdated     DateTime?

  vulnerabilitiesRewarded Int?
  validationWithinDays    Int?
  acceptanceRate          Int?
  averagePayout           Int?
  averagePayoutWindow     String?

  programType     ProgrammeType     @default(public)
  minReward       Int
  maxReward       Int
  rewardCurrency  RewardCurrency    @default(XAF)

  payoutGuidelines String?
  payoutFactors    String[]         @default([])
  rootAccessProgram String?

  hallOfFamers    String[]          @default([])
  recentlyJoined  String[]          @default([])
  totalResearchers Int?

  additionalInformation String?
  thingsToKnow    Json?

  triageTimeHours    Int?
  firstResponseHours Int?
  resolutionDays     Int?
  isNew              Boolean        @default(false)

  status          ProgrammeStatus  @default(actif)
  createdAt       DateTime         @default(now())
  reportsCount    Int              @default(0)

  rewardTiers        RewardTier[]
  targetGroups        TargetGroup[]
  inScopeTargets       ProgrammeTarget[] @relation("InScopeTargets")
  outOfScopeTargets    ProgrammeTarget[] @relation("OutOfScopeTargets")
  announcements        Announcement[]
  activities           Activity[]
  reports              Report[]
  payments             Payment[]

  @@map("programmes")
}

model RewardTier {
  id          String    @id @default(uuid()) @db.Uuid
  programmeId String    @db.Uuid
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  severity    Severity
  min         Int
  max         Int
  note        String?

  @@map("reward_tiers")
}

model TargetGroup {
  id          String    @id @default(uuid()) @db.Uuid
  programmeId String    @db.Uuid
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  title       String
  description String?
  scopeRating String?
  inScope     Boolean
  payoutChart Json?

  targets ProgrammeTarget[] @relation("TargetGroupTargets")

  @@map("target_groups")
}

model ProgrammeTarget {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  tags         String[]     @default([])
  knownIssues  String?

  targetGroupId String?     @db.Uuid
  targetGroup   TargetGroup? @relation("TargetGroupTargets", fields: [targetGroupId], references: [id], onDelete: Cascade)

  inScopeProgrammeId    String?    @db.Uuid
  inScopeProgramme      Programme? @relation("InScopeTargets", fields: [inScopeProgrammeId], references: [id], onDelete: Cascade)

  outOfScopeProgrammeId String?    @db.Uuid
  outOfScopeProgramme   Programme? @relation("OutOfScopeTargets", fields: [outOfScopeProgrammeId], references: [id], onDelete: Cascade)

  @@map("programme_targets")
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  programmeId String    @db.Uuid
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  title       String
  author      String
  createdAt   DateTime  @default(now())
  content     String

  @@map("announcements")
}

enum ActivityType {
  submission
  reward
  announcement
  update
}

model Activity {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  subtitle    String?
  type        ActivityType
  createdAt   DateTime     @default(now())
  priority    Severity?
  amount      Int?
  hackerName  String?
  programmeName String?

  programmeId String?      @db.Uuid
  programme   Programme?   @relation(fields: [programmeId], references: [id], onDelete: SetNull)

  @@map("activities")
}

// ---------------------------------------------------------------------------
// Reports
// ---------------------------------------------------------------------------

enum ReportStatus {
  soumis
  en_analyse
  accepte
  rejete
  resolu
}

enum AnalysisStatus {
  en_attente
  en_cours
  terminee
}

model Report {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String
  severity    Severity
  status      ReportStatus @default(soumis)

  hackerId    String        @db.Uuid
  hacker      HackerProfile @relation(fields: [hackerId], references: [id], onDelete: Cascade)

  programmeId String    @db.Uuid
  programme   Programme @relation(fields: [programmeId], references: [id], onDelete: Cascade)

  entrepriseId String            @db.Uuid
  entreprise   EntrepriseProfile @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  reward      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Free-text fallback fields, kept for backward compatibility with reports submitted
  // before the taxonomy existed. New submissions should set vulnerabilityCategoryId
  // instead; vulnerability/vrtCategory/vrtType stay populated in parallel as a
  // human-readable label (denormalized) since older UI/exports still read them.
  vulnerability String
  vrtCategory   String?
  vrtType       String?
  proof         String
  // pdfFileName is the original filename (display only); pdfPath is the Supabase
  // Storage object key the actual bytes were uploaded to (see reportStorage.ts) —
  // previously only the filename was ever sent, the file itself was discarded.
  pdfFileName   String?
  pdfPath       String?
  pdfUploadedAt DateTime?

  vulnerabilityCategoryId String?              @db.Uuid
  vulnerabilityCategory   VulnerabilityCategory? @relation(fields: [vulnerabilityCategoryId], references: [id])

  // Structured report fields, aligned with standard pentest report conventions
  // (asset / reproduction / impact / remediation / CVSS), additive to the legacy
  // description/proof free-text fields above.
  affectedAsset    String?
  stepsToReproduce String?
  impact           String?
  remediation      String?
  cvssVector       String?
  cvssScore        Float?

  analysisStatus AnalysisStatus?
  aiAnalysis     AiAnalysis?
  payout         Payout?

  // Inverse side of AiAnalysis.duplicateOfId: other reports whose AiAnalysis points
  // back at this one as the earlier/original submission on the same vulnerability.
  duplicateFlags AiAnalysis[] @relation("ReportDuplicateOf")
  fraudSignals   FraudSignal[]
  mcpAgentRuns   McpAgentRun[]

  @@map("reports")
}

model AiAnalysis {
  id                     String   @id @default(uuid()) @db.Uuid
  reportId               String   @unique @db.Uuid
  report                 Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  confidence             Float
  suggestedSeverity      Severity
  isDuplicate            Boolean  @default(false)
  duplicateOfId          String?  @db.Uuid
  duplicateOf            Report?  @relation("ReportDuplicateOf", fields: [duplicateOfId], references: [id])
  summary                String
  reproductionLikelihood Float

  @@map("ai_analyses")
}

// Vulnerability Rating Taxonomy (VRT), inspired by the public HackerOne VRT structure:
// a small hierarchy of categories (parent/child) each optionally mapped to a CWE id,
// with a suggested default severity used to pre-fill (not force) the report form.
model VulnerabilityCategory {
  id   String @id @default(uuid()) @db.Uuid
  // Stable slug used to seed/upsert the curated catalog idempotently, and to derive
  // a unique key for hacker-proposed categories (see taxonomyService.ts) — either
  // way this must stay unique so re-seeding/re-proposing never creates duplicates.
  key  String @unique
  name String
  cweId           String?
  defaultSeverity Severity?
  description     String?

  // true for the curated catalog seeded from vrtCatalog.ts; false for a category a
  // hacker proposed from the report form (taxonomyService.proposeVulnerabilityCategory)
  // after the automatic duplicate check found no close match. Both are listed and
  // usable identically — this only distinguishes provenance for future moderation.
  isSystem Boolean @default(true)

  parentId String?                 @db.Uuid
  parent   VulnerabilityCategory?  @relation("VulnerabilityCategoryHierarchy", fields: [parentId], references: [id])
  children VulnerabilityCategory[] @relation("VulnerabilityCategoryHierarchy")

  reports Report[]

  @@map("vulnerability_categories")
}

// ---------------------------------------------------------------------------
// System configuration (singleton) & platform logs
// ---------------------------------------------------------------------------

enum PasswordComplexity {
  standard
  elevated
  military
}

model SystemConfig {
  id                    Int                @id @default(1)
  platformName          String             @default("Gabon Bug Bounty AI")
  contactEmail          String             @default("admin@bugbounty.ga")
  supportUrl            String             @default("https://support.bugbounty.ga")
  maintenanceMode       Boolean            @default(false)
  maintenanceUntil      DateTime?
  autoTriage            Boolean            @default(true)
  enterpriseValidation  Boolean            @default(true)
  triageLimitHours      Int                @default(48)
  aiSensitivity         Int                @default(75)
  require2FA            Boolean            @default(false)
  ipWhitelisting        Boolean            @default(false)
  sessionTimeout        Int                @default(60)
  passwordComplexity    PasswordComplexity @default(standard)
  globalNotificationsEnabled Boolean       @default(true)

  @@map("system_config")
}

enum LogType {
  security
  performance
  user_action
  system
}

enum LogLevel {
  info
  warning
  error
  critical
}

model PlatformLog {
  id        String   @id @default(uuid()) @db.Uuid
  timestamp DateTime @default(now())
  type      LogType
  level     LogLevel
  message   String
  source    String
  metadata  Json?

  userId String?  @db.Uuid
  user   Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("platform_logs")
}

// ---------------------------------------------------------------------------
// Payments (collection) & payouts (disbursement)
// ---------------------------------------------------------------------------

enum PaymentProvider {
  stripe
  cinetpay
}

enum PaymentStatus {
  pending
  succeeded
  failed
}

enum PayoutStatus {
  pending
  succeeded
  failed
}

// An entreprise funding a programme (money coming into the platform).
model Payment {
  id           String            @id @default(uuid()) @db.Uuid
  programmeId  String            @db.Uuid
  programme    Programme         @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  entrepriseId String            @db.Uuid
  entreprise   EntrepriseProfile @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  provider  PaymentProvider
  status    PaymentStatus @default(pending)
  amount    Int
  currency  String

  // Stripe Checkout Session id, or CinetPay transaction_id
  providerRef String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fraudSignals FraudSignal[]

  @@map("payments")
}

// A reward payout to a hacker for one specific accepted report (money leaving the platform).
model Payout {
  id       String        @id @default(uuid()) @db.Uuid
  reportId String        @unique @db.Uuid
  report   Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  hackerId String        @db.Uuid
  hacker   HackerProfile @relation(fields: [hackerId], references: [id], onDelete: Cascade)

  provider PaymentProvider
  status   PayoutStatus    @default(pending)
  amount   Int
  currency String

  // Stripe Transfer id, or CinetPay transfer transaction id
  providerRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fraudSignals FraudSignal[]

  @@map("payouts")
}

// ---------------------------------------------------------------------------
// Fraud detection (Phase 5) — heuristic signals for human review, never an
// automatic block. See api/src/services/fraud/fraudService.ts for the 4 checks.
// ---------------------------------------------------------------------------

enum FraudSignalType {
  duplicate_account
  hacker_entreprise_collusion
  plagiarized_report
  payment_anomaly
  // Semantic fraud signal from the MCP anti-fraud agent (services/mcpAgents) —
  // complements plagiarized_report's exact/near-exact Jaccard check with real
  // LLM-based semantic analysis (paraphrase, inconsistencies, copied write-ups).
  llm_semantic_anomaly
}

enum FraudSignalStatus {
  open
  reviewing
  confirmed
  dismissed
}

model FraudSignal {
  id       String             @id @default(uuid()) @db.Uuid
  type     FraudSignalType
  status   FraudSignalStatus  @default(open)
  severity Severity
  summary  String
  // Heuristic-specific evidence (matched field, computed rates, thresholds used) —
  // free-form by design since each of the 4 heuristics captures different evidence.
  details  Json

  relatedProfileIds String[] @default([])

  relatedReportId String? @db.Uuid
  relatedReport   Report? @relation(fields: [relatedReportId], references: [id], onDelete: Cascade)

  relatedPaymentId String?  @db.Uuid
  relatedPayment   Payment? @relation(fields: [relatedPaymentId], references: [id], onDelete: Cascade)

  relatedPayoutId String? @db.Uuid
  relatedPayout   Payout? @relation(fields: [relatedPayoutId], references: [id], onDelete: Cascade)

  reviewedById String?   @db.Uuid
  reviewedBy   Profile?  @relation("FraudSignalReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@map("fraud_signals")
}

// ---------------------------------------------------------------------------
// MCP agents — real multi-model (OpenRouter) report analysis pipeline. See
// api/src/services/mcpAgents/. Suggestion-only: nothing here ever mutates a
// Report's status/severity/reward directly — triage/finance apply suggestions
// manually through the existing PATCH /api/reports/:id.
// ---------------------------------------------------------------------------

enum McpAgentType {
  vulnerability_analysis
  severity_assessment
  false_positive_detection
  anti_fraud
  recommendation
  decision
  reward
}

enum McpAgentRunStatus {
  pending
  running
  completed
  failed
}

model McpAgentRun {
  id          String            @id @default(uuid()) @db.Uuid
  reportId    String            @db.Uuid
  report      Report            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status      McpAgentRunStatus @default(pending)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())

  outputs McpAgentOutput[]

  @@map("mcp_agent_runs")
}

model McpAgentOutput {
  id        String            @id @default(uuid()) @db.Uuid
  runId     String            @db.Uuid
  run       McpAgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentType McpAgentType
  // Real OpenRouter model id actually used, e.g. "deepseek/deepseek-chat" — not an
  // enum, since model choice/availability may shift without a schema migration.
  model     String
  status    McpAgentRunStatus @default(pending)

  // Constructed prompt (audit trail / prompt-injection review), zod-validated
  // structured result, and the raw LLM text (kept even on parse failure, for debugging).
  input       Json
  output      Json?
  rawResponse String?

  errorMessage     String?
  latencyMs        Int?
  promptTokens     Int?
  completionTokens Int?

  createdAt DateTime @default(now())

  @@unique([runId, agentType])
  @@map("mcp_agent_outputs")
}
